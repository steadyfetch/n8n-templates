    "jsCode": "// One item per competitor Ad Library URL, so the loop below handles them one at a time.\nconst raw = String($json.competitors || '');\nconst targets = raw.split(/\\r?\\n|,/).map((t) => t.trim()).filter(Boolean);\nif (!targets.length) {\n  throw new Error('No competitor Ad Library URL set. Open the Config node and add at least one.');\n}\nreturn targets.map((target) => ({ json: { target } }));"
   },
