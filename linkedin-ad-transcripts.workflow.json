  {
   "parameters": {
    "jsCode": "// Top five new hooks, longest ad first.\nconst rows = $input.first().json.rows || [];\nconst top = rows.slice().sort((a, b) => (b.seconds || 0) - (a.seconds || 0)).slice(0, 5);\nconst lines = top.map((r) => `• ${r.advertiser || 'Unknown'} — ${r.hook_type || 'hook'}: \"${(r.hook_first_3s || '').trim() || 'no speech'}\"`);\nconst digest = [\n  `*${rows.length} new LinkedIn video ad${rows.length === 1 ? '' : 's'} this week*`,\n  '',\n  ...lines,\n].join('\\n');\nreturn [{ json: { digest, new_ads: rows.length } }];"
   },
