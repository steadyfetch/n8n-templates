  {
   "parameters": {
    "jsCode": "// The ten best opportunities, one line each.\nconst rows = $input.first().json.rows || [];\nconst top = rows.slice(0, 10);\nconst lines = top.map((r) => `${r.rank}. ${r.keyword} — ${(r.avg_monthly_searches || 0).toLocaleString()}/mo · $${Number(r.cpc_usd || 0).toFixed(2)} CPC · ${r.intent || '?'} · ${r.cluster || '?'}`);\nconst digest = [`*${rows.length} new keyword${rows.length === 1 ? '' : 's'} scored*`, '', ...lines].join('\\n');\nreturn [{ json: { digest, new_keywords: rows.length } }];"
   },
