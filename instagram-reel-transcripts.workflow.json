   "parameters": {
    "jsCode": "// One item per Instagram handle, so the loop below handles them one at a time.\nconst raw = String($json.creatorHandles || '');\nconst targets = raw.split(/\\r?\\n|,/).map((t) => t.trim()).filter(Boolean);\nif (!targets.length) {\n  throw new Error('No Instagram handle set. Open the Config node and add at least one.');\n}\nreturn targets.map((target) => ({ json: { target } }));"
   },
