{
  "id": "FbAdTranscripts01",
  "name": "Facebook Ad Transcripts — scrape competitor ads, get hooks & CTAs (free)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "9a1f0001-0000-4000-8000-000000000001",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-220, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-token",
              "name": "apifyToken",
              "value": "PASTE_YOUR_APIFY_TOKEN_HERE",
              "type": "string"
            },
            {
              "id": "cfg-url",
              "name": "adLibrarySearchUrl",
              "value": "https://www.facebook.com/ads/library/?active_status=active&ad_type=all&country=US&media_type=video&q=fitness&search_type=keyword_unordered",
              "type": "string"
            },
            {
              "id": "cfg-max",
              "name": "maxAds",
              "value": 20,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "9a1f0002-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/curious_coder~facebook-ads-library-scraper/run-sync-get-dataset-items?token={{ $('Config').first().json.apifyToken }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ urls: [{ url: $('Config').first().json.adLibrarySearchUrl }], count: $('Config').first().json.maxAds }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "9a1f0003-0000-4000-8000-000000000003",
      "name": "Scrape Facebook Ads (Ad Library)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/steadyfetch~facebook-ads-transcript-scraper/run-sync-get-dataset-items?token={{ $('Config').first().json.apifyToken }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ datasetItems: $input.all().map(item => item.json), maxAds: $('Config').first().json.maxAds }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "9a1f0004-0000-4000-8000-000000000004",
      "name": "Transcribe Ads — hooks & CTAs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f-status", "name": "status", "value": "={{ $json.status }}", "type": "string" },
            { "id": "f-adv", "name": "advertiser", "value": "={{ $json.pageName }}", "type": "string" },
            { "id": "f-hook", "name": "hook_first_3s", "value": "={{ $json.hook3s }}", "type": "string" },
            { "id": "f-cta", "name": "cta", "value": "={{ $json.ctaText }}", "type": "string" },
            { "id": "f-text", "name": "transcript", "value": "={{ $json.transcript }}", "type": "string" },
            { "id": "f-sec", "name": "seconds", "value": "={{ $json.durationSeconds }}", "type": "number" },
            { "id": "f-charged", "name": "charged", "value": "={{ $json.charged }}", "type": "boolean" }
          ]
        },
        "options": {}
      },
      "id": "9a1f0005-0000-4000-8000-000000000005",
      "name": "Tidy fields (pipe to Sheets from here)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 0]
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Scrape Facebook Ads (Ad Library)", "type": "main", "index": 0 }]]
    },
    "Scrape Facebook Ads (Ad Library)": {
      "main": [[{ "node": "Transcribe Ads — hooks & CTAs", "type": "main", "index": 0 }]]
    },
    "Transcribe Ads — hooks & CTAs": {
      "main": [[{ "node": "Tidy fields (pipe to Sheets from here)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
