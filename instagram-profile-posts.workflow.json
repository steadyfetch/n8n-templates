{
  "id": "IgProfilePosts01",
  "name": "Pull the latest posts and reels from Instagram profiles into a table using Apify",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Pull the latest posts and reels from Instagram profiles into a table\n\n**Setup (3 minutes)**\n1. Open **Config** and paste your Apify API token.\n2. Set `profiles` (handles or profile URLs, comma-separated) and `postsPerProfile`.\n3. Click **Test workflow**.\n\n**What you get:** one row per post or reel, newest by date (pinned posts are flagged, not promoted to the top), with caption, hashtags, like and comment counts, plays and duration for videos, and the media URL. No login, no cookies. Your limit is exact: 30 means 30.\n\n**Cost:** steadyfetch/instagram-profile-posts, from $0.60 per 1,000 posts on Apify's Business plan ($2.40 on the free plan). Two profiles × 30 posts is about $0.15 on the free plan.",
        "height": 340,
        "width": 640,
        "color": 5
      },
      "id": "9b2e0003-0000-4000-8000-000000000009",
      "name": "Read me first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -360
      ]
    },
    {
      "parameters": {},
      "id": "9b2e0003-0000-4000-8000-000000000001",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-token",
              "name": "apifyToken",
              "value": "PASTE_YOUR_APIFY_TOKEN_HERE",
              "type": "string"
            },
            {
              "id": "cfg-profiles",
              "name": "profiles",
              "value": "nasa, natgeo",
              "type": "string"
            },
            {
              "id": "cfg-limit",
              "name": "postsPerProfile",
              "value": 30,
              "type": "number"
            },
            {
              "id": "cfg-type",
              "name": "mediaType",
              "value": "any",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "9b2e0003-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/steadyfetch~instagram-profile-posts/run-sync-get-dataset-items?token={{ $('Config').first().json.apifyToken }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ profiles: String($('Config').first().json.profiles).split(/\\r?\\n|,/).map(h => h.trim()).filter(Boolean), resultsLimit: $('Config').first().json.postsPerProfile, mediaType: $('Config').first().json.mediaType }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "9b2e0003-0000-4000-8000-000000000003",
      "name": "Fetch the profiles' latest posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "9b2e0003-0000-4000-8000-000000000094",
              "leftValue": "={{ typeof $json.shortCode === 'string' && $json.shortCode.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9b2e0003-0000-4000-8000-000000000004",
      "name": "Post rows only (skip profile and summary rows)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f-profile",
              "name": "profile",
              "value": "={{ $json.ownerUsername }}",
              "type": "string"
            },
            {
              "id": "f-url",
              "name": "post_url",
              "value": "={{ $json.url }}",
              "type": "string"
            },
            {
              "id": "f-type",
              "name": "type",
              "value": "={{ $json.type }}",
              "type": "string"
            },
            {
              "id": "f-date",
              "name": "posted_at",
              "value": "={{ $json.takenAt }}",
              "type": "string"
            },
            {
              "id": "f-caption",
              "name": "caption",
              "value": "={{ $json.caption }}",
              "type": "string"
            },
            {
              "id": "f-likes",
              "name": "likes",
              "value": "={{ $json.likeCount }}",
              "type": "number"
            },
            {
              "id": "f-comments",
              "name": "comments",
              "value": "={{ $json.commentCount }}",
              "type": "number"
            },
            {
              "id": "f-plays",
              "name": "plays",
              "value": "={{ $json.playCount }}",
              "type": "number"
            },
            {
              "id": "f-sec",
              "name": "video_seconds",
              "value": "={{ $json.videoDuration }}",
              "type": "number"
            },
            {
              "id": "f-pinned",
              "name": "is_pinned",
              "value": "={{ $json.isPinned }}",
              "type": "boolean"
            },
            {
              "id": "f-media",
              "name": "media_url",
              "value": "={{ $json.videoUrl || $json.displayUrl }}",
              "type": "string"
            },
            {
              "id": "f-charged",
              "name": "charged",
              "value": "={{ $json.charged }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "9b2e0003-0000-4000-8000-000000000005",
      "name": "Tidy fields (pipe to Sheets from here)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        -80
      ]
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
